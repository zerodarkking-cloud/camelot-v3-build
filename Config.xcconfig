// Единственное место, где задаются идентификаторы проекта.

// Team ID из developer.apple.com → Membership (10 символов). Можно оставить пустым
// и выбрать команду в Xcode: Signing & Capabilities у обеих целей.
DEVELOPMENT_TEAM =

APP_BUNDLE_ID = com.camelot.browser.app
TUNNEL_BUNDLE_ID = $(APP_BUNDLE_ID).tunnel-extension
APP_GROUP_ID = group.com.camelot.browser.shared
