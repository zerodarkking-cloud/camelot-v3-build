<Project Sdk="Microsoft.NET.Sdk">

  <!-- Проверки логики без внешних пакетов: dotnet run, аргумент — папка для конфигов.
       Сгенерированные конфиги затем проверяются настоящим sing-box (sing-box check). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Camelot.Core\Camelot.Core.csproj" />
  </ItemGroup>

</Project>
